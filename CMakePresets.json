{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/cmake-build/${presetName}",
      "installDir": "${sourceDir}/cmake-build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "base-files",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "HOT_ENABLE_CLANG_FILES": "ON",
        "HOT_ENABLE_JIT": "OFF"
      }
    },
    {
      "name": "base-jit",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "HOT_ENABLE_CLANG_FILES": "OFF",
        "HOT_ENABLE_JIT": "ON"
      }
    },
    {
      "name": "base-clang",
      "hidden": true,
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "base-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "base-tsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "linux-clang-files",
      "inherits": ["base-clang", "base-files"]
    },
    {
      "name": "linux-clang-files-asan",
      "inherits": ["base-clang", "base-asan", "base-files"]
    },
    {
      "name": "linux-clang-files-tsan",
      "inherits": ["base-clang", "base-tsan", "base-files"]
    },
    {
      "name": "linux-clang-jit",
      "inherits": ["base-clang", "base-jit"]
    },
    {
      "name": "vs-files",
      "description": "No generator: CMake takes the newest Visual Studio of the host.",
      "binaryDir": "${sourceDir}/cmake-build/${presetName}",
      "installDir": "${sourceDir}/cmake-build/${presetName}/install",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo",
        "HOT_ENABLE_CLANG_FILES": "ON",
        "HOT_ENABLE_JIT": "OFF",
        "HOT_DOWNLOAD_LLVM": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mingw-files",
      "inherits": "base-files",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake"
    },
    {
      "name": "mingw-llvm",
      "inherits": "mingw-files",
      "cacheVariables": {
        "HOT_LLVM_RELEASES_DIR": "${sourceDir}/cmake-build",
        "HOT_BUILD_TRANSLATOR": "ON"
      }
    },
    {
      "name": "linux-clang-jit-asan",
      "inherits": ["base-clang", "base-asan", "base-jit"]
    },
    {
      "name": "linux-clang-jit-tsan",
      "inherits": ["base-clang", "base-tsan", "base-jit"]
    }
  ],
  "buildPresets": [
    { "name": "linux-clang-files-dbg", "configurePreset": "linux-clang-files", "configuration": "Debug" },
    { "name": "linux-clang-files-rel", "configurePreset": "linux-clang-files", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-files-asan", "configurePreset": "linux-clang-files-asan", "configuration": "Debug" },
    { "name": "linux-clang-files-tsan", "configurePreset": "linux-clang-files-tsan", "configuration": "Debug" },
    { "name": "vs-files-dbg", "configurePreset": "vs-files", "configuration": "Debug" },
    { "name": "vs-files-rel", "configurePreset": "vs-files", "configuration": "RelWithDebInfo" },
    { "name": "mingw-files-dbg", "configurePreset": "mingw-files", "configuration": "Debug" },
    { "name": "mingw-llvm-dbg", "configurePreset": "mingw-llvm", "configuration": "Debug" },
    { "name": "linux-clang-jit-dbg", "configurePreset": "linux-clang-jit", "configuration": "Debug" },
    { "name": "linux-clang-jit-rel", "configurePreset": "linux-clang-jit", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-jit-asan", "configurePreset": "linux-clang-jit-asan", "configuration": "Debug" },
    { "name": "linux-clang-jit-tsan", "configurePreset": "linux-clang-jit-tsan", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "linux-clang-files-dbg", "inherits": "base-test", "configurePreset": "linux-clang-files", "configuration": "Debug" },
    { "name": "linux-clang-files-rel", "inherits": "base-test", "configurePreset": "linux-clang-files", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-files-asan", "inherits": "base-test", "configurePreset": "linux-clang-files-asan", "configuration": "Debug" },
    { "name": "linux-clang-files-tsan", "inherits": "base-test", "configurePreset": "linux-clang-files-tsan", "configuration": "Debug" },
    { "name": "vs-files-dbg", "inherits": "base-test", "configurePreset": "vs-files", "configuration": "Debug" },
    { "name": "vs-files-rel", "inherits": "base-test", "configurePreset": "vs-files", "configuration": "RelWithDebInfo" },
    { "name": "mingw-files-dbg", "inherits": "base-test", "configurePreset": "mingw-files", "configuration": "Debug" },
    { "name": "mingw-llvm-dbg", "inherits": "base-test", "configurePreset": "mingw-llvm", "configuration": "Debug" },
    { "name": "linux-clang-jit-dbg", "inherits": "base-test", "configurePreset": "linux-clang-jit", "configuration": "Debug" },
    { "name": "linux-clang-jit-rel", "inherits": "base-test", "configurePreset": "linux-clang-jit", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-jit-asan", "inherits": "base-test", "configurePreset": "linux-clang-jit-asan", "configuration": "Debug" },
    { "name": "linux-clang-jit-tsan", "inherits": "base-test", "configurePreset": "linux-clang-jit-tsan", "configuration": "Debug" }
  ]
}
