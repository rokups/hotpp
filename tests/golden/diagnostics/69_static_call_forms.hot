using "Actor.h";

int Twice(int x) { return x * 2; }

class Util : Actor {
    int hp;
    int Hp { get; set; }
    static int Make(int x) { return x + 1; }
    static int Ok($Util other)
    {
        if (other == null)
            return 0;
        return Make(1) + Twice(2) + other.hp + other.Hp;
    }
}

class User : Actor {
    static int Own(int x) { return x; }
    void Run() {
        var u = new $Util();
        int a = Util.Make(2) + Twice(1);
        int b = u.Make(3);
        var f = Util.Make;
        var g = Twice;
        var h = this.Own(1);
    }
}
