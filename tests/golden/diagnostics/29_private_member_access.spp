using "Actor.h";

class Counter : Actor {
    private int count = 0;
    private int Twice() { return count * 2; }

    void Bump() { count += 1; }
}

class Spy : Actor {
    int Peek(Counter c) { return c.count; }

    int Both(Counter c)
    {
        int a = c.count;
        int b = c.Twice();
        return a + b;
    }
}
