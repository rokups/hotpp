using <vector>;

class Holder {
    std.vector<int> xs;
    std.vector<int> other;

    void Push() {
        foreach (var x in xs) {
            xs.push_back(x);
        }
    }

    void Erase() {
        foreach (int x in this.xs) {
            this.xs.erase(xs.begin());
            xs.clear();
        }
    }

    void Assign(std.vector<int> list) {
        foreach (var x in list) {
            list = other;
            list.resize(1);
        }
    }
}
