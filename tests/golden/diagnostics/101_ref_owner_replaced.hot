class Part {
    int hp = 0;
}

class Holder {
    Part part;
    $Part shared;
    int? opt;

    void Member() {
        ref r = this.part.hp;
        this.part = new Part();
        r = 1;
    }

    void Handle() {
        ref r = this.shared.hp;
        this.shared = new $Part();
        r = 1;
    }

    void Deref() {
        int? h = 1;
        ref v = *h;
        h = null;
        v = 1;
    }

    void Optional() {
        ref v = *this.opt;
        this.opt = null;
        v = 1;
    }
}
