using "Actor.h";

class Counter : Actor {
    private int count = 0;
    private int Twice() { return count * 2; }

    void Bump() { count += 1; }
}

class Spy : Actor {
    int Peek($Counter c) {
        if (c == null) return 0;
        return c.count;
    }

    int Both($Counter c)
    {
        if (c == null) return 0;
        int a = c.count;
        int b = c.Twice();
        return a + b;
    }
}
