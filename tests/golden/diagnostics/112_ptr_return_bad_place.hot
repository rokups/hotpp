using <vector>;

struct Info {
    int x = 0;
}

class Catalog {
    std.vector<Info> items;

    Info* Local() {
        Info i = Info();
        return &i;
    }

    Info* Copy(Info a) {
        return &a;
    }

    Info* Other() {
        return Local();
    }

    void Keep() {
        var p = Local();
        var f = () => { p.x = 1; };
    }
}
