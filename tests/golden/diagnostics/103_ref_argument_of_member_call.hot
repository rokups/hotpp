using <vector>;

class Holder {
    std.vector<int> xs;

    void Fill(ref std.vector<int> v) {
        v.push_back(1);
    }

    static void SFill(ref std.vector<int> v) {
        v.push_back(1);
    }

    void ThroughThis() {
        ref r = xs[0];
        this.Fill(xs);
        r = 1;
    }

    void ThroughClass() {
        ref r = xs[0];
        Holder.SFill(this.xs);
        r = 1;
    }
}
