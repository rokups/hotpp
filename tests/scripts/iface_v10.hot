// The interface IThing is renamed to IThing2. The field keep changes its type.
using "Actor.h";
using <string>;

interface IThing2 {
    int Get();
}

class C : Actor, IThing2 {
    int Get() { return 10; }
}

class Holder : Actor {
    C obj;
    IThing2 keep;
    int r = 0;
    int is_i = -1;
    int threw = 0;
    std.string why = "";
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        if (this.keep == null) {
            this.obj = new C();
            this.keep = this.obj;
        }
        this.is_i = 0;
        if (this.obj is IThing2) this.is_i = 1;
        this.threw = 0;
        this.r = -5;
        try {
            this.r = this.keep.Get();
        } catch (hot.ScriptError ex) {
            this.threw = 1;
            this.why = ex.what();
        }
    }
}
