// A test script for the non-null assertion "x!": a member access, a call, an initializer and a lambda.
using "Actor.h";

class Node {
    int v = 5;
    $Node next = null;
    $Node Next() { return next; }
}

class Holder : Actor {
    $Node head = null;
    int n = 0;

    int First() {
        return head!.v;
    }

    int Second() {
        $Node x = head!.Next()!;
        return x!.v;
    }

    void arm(ref World w, float delay) {
        w.AddTimer(delay, () => {
            this.n = head!.v;
        });
    }
}
