// Generation 1 of the Link and Chain classes: type-directed access on script handles (S5b).
// Chain holds a Link handle. It uses a field, a script function and a property of the Link.
// Link returns "this" as a handle.
using "Actor.h";
using <string>;

class Link : Actor {
    int hits = 0;

    Link(std.string label) : base(label) { }

    int Power {
        get { return this.hits * 2; }
    }

    void Hit(int n) {
        this.hits = this.hits + n;
    }

    $Link Self() {
        return this;
    }
}

class Chain : Actor {
    $Link first;
    int power = 0;
    int seen = 0;

    override void Tick(float dt) {
        $Link first = new $Link(std.string("link"));
        this.first = first;
        first.Hit(3);
        first.hits = first.hits + 1;
        this.power = first.Power;
        var same = first.Self();
        if (same == null) return;
        same.Hit(1);
        this.seen = same.hits;
    }
}
