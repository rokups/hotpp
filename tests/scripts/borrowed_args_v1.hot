// Generation 1: a borrowed value is valid for the whole call, so every call form takes it
// (task 40). Distance and Util.Sum are native calls that take "const Vec3&".
using "Actor.h";
using "Util.h";

class Probe {
    float last = 0;
    Probe() { }
    Probe(Vec3* p) {
        if (p == null) return;
        last = p.x;
    }
    void Look(ref Vec3 v) { last = v.x; }
    void Take(Vec3* p) {
        if (p == null) return;
        last = p.y;
    }
    // Passes the borrowed values on to native calls and to other methods.
    float Pass(ref Vec3 v, Vec3* p) {
        if (p == null) return 0;
        Look(v);
        Take(p);
        return Distance(v, *p);
    }
}

class Caller : Actor {
    $Probe probe = null;

    float Run(ref Vec3 v, Vec3* p, bool c) {
        if (p == null) return 0;
        Vec3 a;
        Vec3 b;
        ref r = a;
        var q = &b;
        probe = new $Probe(&a);
        $Probe pb = probe;
        if (pb == null) return 0;
        var other = new $Probe(p);
        pb.Look(v);
        pb.Take(&a);
        pb.Take(q);
        pb.Look(r);
        pb.Take(c ? &a : &b);
        pb.Take(c ? p : &a);
        pb.Take((Vec3*)&a);
        pb.Take(&*p);
        var f = (ref Vec3 w) => { pb?.Look(w); };
        f(a);
        f(v);
        float d = Distance(*(c ? &a : &b), *p);
        return d + pb.Pass(v, p) + other.Pass(*q, &a) + Util.Sum(r);
    }
}
