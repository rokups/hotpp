// C stops to list IThing. The stored interface value keeps the object, but the call throws.
using "Actor.h";
using <string>;

interface IThing {
    int Get();
}

class C : Actor {
    int Get() { return 2; }
}

class Holder : Actor {
    C obj;
    IThing keep;
    int r = 0;
    int is_i = -1;
    int threw = 0;
    std.string why = "";
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;

        this.is_i = 0;
        if (this.obj is IThing) this.is_i = 1;
        this.threw = 0;
        this.r = -5;
        try {
            this.r = this.keep.Get();
        } catch (hot.ScriptError ex) {
            this.threw = 1;
            this.why = ex.what();
        }
    }
}
