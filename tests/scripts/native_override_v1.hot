// Generation 1 of the removed native override test. The class Scout overrides the native
// virtual Area() of IfaceNative. The native base returns 7. The override returns 70.
using "IfaceNative.h";

class Scout : IfaceNative {
    int mark = 1;

    override int Area() { return 70; }
}
