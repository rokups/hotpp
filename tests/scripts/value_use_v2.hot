// Generation 2 of the [value] test. The field "a" stays, so the loader migrates the object in
// its box. The field "added" is new and has an initializer. The other fields go away.
using "Actor.h";

class Pt {
    int x = 1;
    int Get() { return this.x; }
}

class Sub : Pt {
    int y = 7;
}

class Holder : Actor {
    [value] Pt a;
    [value] Pt added = new Pt();
    int ticks = 0;

    // The methods of generation 1 stay: a reload cannot remove a slot.
    int Bump([value] Pt p) {
        p.x = p.x + 1;
        return p.x;
    }

    [value] Pt Make(int v) {
        [value] Pt t = new Pt();
        t.x = v;
        return t;
    }

    [value] Pt Dup() {
        return this.a;
    }

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
    }
}
