// Generation 2 of a module variable that holds script objects (gap G11). The object in the
// vector migrates: "points" keeps its value, the new field "bonus" has its initializer. The
// Tick clears the vector, so the object is deleted before the session ends.
using "Actor.h";
using <vector>;

class Score {
    int points = 0;
    int bonus = 7;
}

std.vector<$Score> scores;
int seen = 0;
int left = 0;

class Hero : Actor {
    override void Tick(float dt) {
        if (scores.size() == 0) { return; }
        scores[0].points += 10;
        seen = scores[0].points + scores[0].bonus;
        scores.clear();
        left = (int)scores.size() + 100;
    }
}
