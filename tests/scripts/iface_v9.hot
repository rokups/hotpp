// The class C is removed. The Holder keeps the interface value of a C object.
using "Actor.h";
using <string>;

interface IThing {
    int Get();
}



class Holder : Actor {

    IThing keep;
    int r = 0;
    int is_i = -1;
    int threw = 0;
    std.string why = "";
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;

        this.is_i = -1;
        this.threw = 0;
        this.r = -5;
        try {
            this.r = this.keep.Get();
        } catch (hot.ScriptError ex) {
            this.threw = 1;
            this.why = ex.what();
        }
    }
}
