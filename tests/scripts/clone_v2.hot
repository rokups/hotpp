// Generation 2 of the clone test: Base has the new field "added". Base and Derived have no native base, so a host can copy
// them with hot::clone_shell. The constructor of Base sets "n" to 100, so a run of it shows.
using "Actor.h";
using <string>;

class Base {
    int n = 1;
    std.string label = "base";
    int added = 55;

    Base() {
        this.n = 100;
    }

    ~Base() {
        std.printf("[clone_v2] base %d gone\n", this.n);
    }
}

class Derived : Base {
    int extra = 7;
}

class Holder : Actor {
    Base plain;
    Base derived;

    override void Tick(float dt) {
        if (this.plain == null) {
            this.plain = new Base();
            this.derived = new Derived();
        }
    }
}
