// Generation 1 of the Gate class: a concrete class with a virtual method.
using "Actor.h";

 class Gate : Actor {
    int ticks = 0;
    int last = 0;

    Gate() { this.last = 1; }

    virtual int Power() { return 5; }

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        this.last = Power();
    }
}
