// Generation 2 of the class constants (gap G01). A reload gives the new value of a constant.
using "Actor.h";

struct Rule {
    static const int Bonus = 2;
}

class Hero : Actor {
    static const int Step = 5;
    int ticks = 0;
    int last = 0;

    override void Tick(float dt) {
        switch (this.ticks) {
            case Step: this.last = Rule.Bonus; break;
            default: break;
        }
        this.ticks = this.ticks + Hero.Step;
    }
}
