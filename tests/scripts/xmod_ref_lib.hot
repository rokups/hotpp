// The owner module of a class with a "ref" method. "xmod_ref_use.hot" imports it.
using <vector>;

struct Slot {
    int x = 0;
}

class Shelf {
    std.vector<Slot> slots;

    ref Slot At(int i) {
        return this.slots[i];
    }
}
