using "Actor.h";

// Constructor overloads (S20a). C++ selects one by the argument types.
class Unit : Actor {
    int hp = 0;
    int kind = 0;

    Unit() : base(std.string("unit")) { this.kind = 1; }
    Unit(int h) : base(std.string("unit")) { this.hp = h; this.kind = 2; }
    Unit(float f) : base(std.string("unit")) { this.hp = 50; this.kind = 3; }
    Unit(int h, ref int seen) : base(std.string("unit")) { this.hp = h; seen = h * 2; this.kind = 4; }
}

// The parent overload comes from the "base(...)" arguments of the child.
class Elite : Unit {
    Elite() : base(1.5) { }
    Elite(int h) : base(h + 1) { }
}

// No constructor and no "new" in generation 1.
class Plain : Actor {
    int v = 3;
}

class Spawner : Actor {
    int k0 = 0;
    int k1 = 0;
    int k2 = 0;
    int k3 = 0;
    int seen = 0;
    int elite = 0;
    int plain = 0;

    override void Tick(float dt) {
        $Unit u0 = new $Unit();
        $Unit u1 = new $Unit(7);
        $Unit u2 = new $Unit(2.5);
        int s = 0;
        $Unit u3 = new $Unit(4, s);
        $Unit u4 = new $Elite();
        $Unit u5 = new $Elite(8);
        this.k0 = u0.kind;
        this.k1 = u1.hp;
        this.k2 = u2.kind;
        this.k3 = u3.kind;
        this.seen = s;
        this.elite = u4.kind * 100 + u5.hp;
        $Plain p = new $Plain();
        this.plain = p.v;
    }
}
