// Generation 1 of the defunct slot call test. Oracle has three functions with a result:
// a class by value (std.string), an int and a handle. Generation 2 removes all three.
using "Actor.h";
using <string>;

class Peer : Actor {
    int mark = 1;
}

class Oracle : Actor {
    int hp = 10;

    std.string Label() {
        return std.string("gen1 label that does not fit in a small buffer");
    }

    int Score() {
        return 7;
    }

    $Peer Friend() {
        return new $Peer();
    }

    void Touch() {
        this.hp = this.hp + 1;
    }
}
