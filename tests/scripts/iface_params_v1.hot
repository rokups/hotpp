// Interface methods with a reference, a const reference, a [weak] handle, a parameter and
// a script class type. The row signature must equal the helper signature.
using "Actor.h";
using <string>;

class Pt {
    int x = 1;
}

interface IParams {
    int ByRef(ref int result);
    int ByConst(in std.string s);
    int Weak([weak] $Pt p);
    int Val(Pt p);
    $Pt Handle($Pt p);
}

class Impl : Actor, IParams {
    int ByRef(ref int result) { result = 42; return 1; }
    int ByConst(in std.string s) {
        if (s == "abc") return 3;
        return 0;
    }
    int Weak([weak] $Pt p) {
        $Pt strong = p;
        if (strong == null) return -1;
        return strong.x;
    }
    int Val(Pt p) {
        p.x = p.x + 1;
        return p.x;
    }
    $Pt Handle($Pt p) {
        if (p == null) return null;
        p.x = p.x + 10;
        return p;
    }
}

class Prober : Actor {
    int r_ref = 0;
    int out_ref = 0;
    int r_const = 0;
    int r_weak = 0;
    int r_val = 0;
    int r_val_after = 0;
    int r_handle = 0;

    override void Tick(float dt) {
        $Impl im = new $Impl();
        IParams ip = im;
        $Pt p = new $Pt();
        Pt v = new $Pt();
        int o = 0;
        this.r_ref = ip.ByRef(o);
        this.out_ref = o;
        this.r_const = ip.ByConst("abc");
        this.r_weak = ip.Weak(p);
        this.r_val = ip.Val(v);
        this.r_val_after = v.x;
        $Pt h = ip.Handle(p);
        if (h == null) return;
        this.r_handle = h.x;
    }
}
