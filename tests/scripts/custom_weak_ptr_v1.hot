// A pointer field of a native class with a custom weak handle (stub attribute "weak_handle").
// The stub of RefBase is a weak source: the field "target" is a hot::CheckedPtr<RefBase>.
// The host sets the field. The field does not keep the object alive.
using "Actor.h";
using "RefPtr.h";

[native, handle("RefPtr<$T>"), weak_handle("WeakRef<$T>")] class RefBase;

class Holder : Actor {
    RefBase* target = null;
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
    }
}
