// A test script for optimized AOT code. A field of another script object and a field of this
// in a lambda must not use state_of: the shell has the fields.
using "Actor.h";

class A {
    int v = 5;
}

class B : Actor {
    $A a = null;
    int n = 0;

    int ReadA() {
        $A x = a;
        if (x == null) return 0;
        return x.v;
    }

    void arm(ref World w, float delay) {
        w.AddTimer(delay, () => {
            this.n = this.n + 1;
        });
    }
}
