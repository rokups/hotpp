// A script method calls a protected non-virtual member of the native base: in a method, in a lambda
// and in a child script class.
using "ProtBase.h";

class Parent : ProtBase {
    void PokeDirect(int n) {
        Poke(n);
    }

    void PokeThis(int n) {
        this.Poke(n);
    }

    void PokeLambda() {
        var f = () => {
            Poke(4);
        };
        f();
    }
}

class Child : Parent {
    void PokeChild(int n) {
        Poke(n);
    }

    void PokeChildLambda() {
        var f = () => {
            this.Poke(2);
        };
        f();
    }
}
