// Script attributes: "[attribute] class Name;" declares an attribute class. A script class
// uses it as a tag. The loader stats give the tags of each class.
using "Actor.h";

[attribute] class Spawnable;
[attribute] class Editor;

[Spawnable, Editor]
class Player : Actor {
    int hp = 1;
}

class Plain : Actor {
}
