// Generation 1 of the host type test. The host rule gives each shell below TypedActor its own type tag.
using "TypedActor.h";

[cpp_prelude("HOT_TEST_TYPED($N, $B);"), cpp_overrides("GetTag")] class : TypedActor;

class Scout : TypedActor {
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
    }
}

class Ranger : Scout {
    int arrows = 10;
}
