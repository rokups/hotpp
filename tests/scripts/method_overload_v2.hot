// Generation 2 adds the overload Score(int, int) and changes the body of Score(int).
using "Actor.h";

class Ov : Actor {
    int total = 0;
    int ticks = 0;
    int kinds = 0;

    int Score(int x) {
        return x * 3;
    }

    int Score(float x) {
        return 1000;
    }

    int Score(int a, int b) {
        return a + b;
    }

    virtual int Kind(int x) {
        return 1;
    }

    virtual int Kind(std.string s) {
        return 2;
    }

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        float f = 0.5;
        this.total = this.Score(5) + this.Score(f) + this.Score(1, 2);
        this.kinds = this.Kind(1) + this.Kind("a");
    }
}

class OvChild : Ov {
    override int Kind(int x) {
        return 10;
    }
}
