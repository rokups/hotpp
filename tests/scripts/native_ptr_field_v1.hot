// Generation 1 of the native pointer field test. The field "target" is a native pointer to Charm.
// The host sets the field. The field is a hot::CheckedPtr<Charm>.
using "Actor.h";
using "Equip.h";

class Holder : Actor {
    Charm* target = null;
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
    }
}
