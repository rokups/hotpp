// Generation 2 of the test with two removals. The class Ghost is gone.
using "Actor.h";

class Hero : Actor {
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
    }
}

class Wraith : Actor {
    int haunts = 0;

    override void Tick(float dt) {
        this.haunts = this.haunts + 1;
    }
}
