// Generation 1 of the module variables with an order and a convert hook (S16).
// "doubled" reads "seed" in its initializer. Probe changes "doubled" in each Tick.
using "Actor.h";

int seed = 5;
int doubled = seed * 2;
int level = 3;

class Probe : Actor {
    int seen = 0;

    override void Tick(float dt) {
        doubled = doubled + 1;
        this.seen = doubled;
    }
}
