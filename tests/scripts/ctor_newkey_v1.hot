using "Actor.h";
using <string>;

// Generation 1 of S27. Unit has one constructor. Its key type is the tuple of std::string.
class Unit : Actor {
    int hp = 0;
    int kind = 0;

    Unit(int h) : base(std.string("unit")) { this.hp = h; this.kind = 1; }
}

class Spawner : Actor {
    int hp_int = 0;
    int hp_float = 0;
    int kind_float = 0;

    override void Tick(float dt) {
        $Unit u1 = new $Unit(3);
        this.hp_int = u1.hp;
    }
}
