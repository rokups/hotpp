// Generation 1 of the removed function test. The class Medic has two functions.
// Generation 2 does not have rest(). The slot of rest() stays defunct and the reload applies live.
// The file medic_reparent.hot is a script with a full reload trigger for the same class.
using "Actor.h";

class Medic : Actor {
    int hp = 10;

    void heal(int amount) {
        this.hp = this.hp + amount;
    }

    void rest() {
        this.hp = this.hp + 1;
    }
}
