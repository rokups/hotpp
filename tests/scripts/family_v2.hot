// Generation 2 of a family of script classes (S6b, design 4.5, 7.6 and 7.9).
// A is the root. B and S are children of A. G is a child of B. A has the property Score.
// B has the property Bonus. A child object reads and writes the inherited properties.
// Driver uses the family through a parent handle and through a child handle.
using "Actor.h";
using <string>;

class A : Actor {
    int a = 1;
    int Score { get; set; } = 10;
    int Rank { get; set; } = 3;

    A(int v) : base(std.string("a")) { this.a = v; }

    virtual int f(int k) { return k; }
}

class B : A {
    int b = 2;
    int Bonus {
        get { return this.b * 3; }
        set { this.b = value; }
    }

    B(int v) : base(v * 2) { }

    override int f(int k) { return k + this.b; }

    virtual void h() { this.b = this.b + Score; }
}

class S : A {
    S() : base(3) { }

    int only() { return Score + 100; }
}

class G : B {
    G() : base(4) { }

    override int f(int k) { return base.f(k) * 2; }

    override void h() {
        base.h();
        Score += 1;
        this.Bonus = Bonus + 1;
    }
}

class Driver : Actor {
    $A top = null;
    $S sib = null;
    $G leaf = null;
    int top_score = 0;
    int leaf_score = 0;
    int sib_score = 0;
    int sib_only = 0;
    int top_f = 0;
    int leaf_bonus = 0;
    int leaf_a = 0;
    int leaf_rank = 0;
    int ticks = 0;

    override void Tick(float dt) {
        if (this.top == null) {
            $G g = new $G();
            $S s = new $S();
            this.leaf = g;
            this.top = g;
            this.sib = s;
            g.Score = 20;
            g.h();
            s.Score = 7;
        }
        this.ticks = this.ticks + 1;
        $A top = this.top;
        $G leaf = this.leaf;
        $S sib = this.sib;
        if (top == null || leaf == null || sib == null) return;
        this.top_score = top.Score;
        this.leaf_score = leaf.Score;
        this.sib_score = sib.Score;
        this.sib_only = sib.only();
        this.top_f = top.f(1);
        this.leaf_bonus = leaf.Bonus;
        this.leaf_a = leaf.a;
        this.leaf_rank = leaf.Rank + sib.Rank;
    }
}
