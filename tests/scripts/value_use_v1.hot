// Generation 1 of the [value] test. The first Tick runs each use of [value] once. The results go
// to the int fields, and the host reads them. Generation 2 keeps the field "a".
using "Actor.h";
using <exception>;

class Pt {
    int x = 1;
    int Get() { return this.x; }
}

class Sub : Pt {
    int y = 7;
}

class Holder : Actor {
    [value] Pt a;
    [value] Pt b = new Pt();
    [value] Pt sub = new Sub();
    int ticks = 0;
    int r_a = 0;
    int r_b = 0;
    int r_param = 0;
    int r_param_a = 0;
    int r_ret = 0;
    int r_dup = 0;
    int r_handle = 0;
    int r_hv = 0;
    int r_z = 0;
    int r_lam = 0;
    int r_cap = 0;
    int r_var = 0;
    int caught_null = 0;

    int Bump([value] Pt p) {
        p.x = p.x + 1;
        return p.x;
    }

    [value] Pt Make(int v) {
        [value] Pt t = new Pt();
        t.x = v;
        return t;
    }

    [value] Pt Dup() {
        return this.a;
    }

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        if (this.ticks == 1) {
            this.a.x = 10;
            this.b = this.a;
            this.b.x = 20;
            this.r_a = this.a.x;
            this.r_b = this.b.x;

            this.r_param = this.Bump(this.a);
            this.r_param_a = this.a.x;

            this.b = this.Make(7);
            this.r_ret = this.b.x;

            [value] Pt d = this.Dup();
            d.x = 99;
            this.r_dup = this.a.x;

            Pt h = new Pt();
            h.x = 42;
            [value] Pt hv = h;
            hv.x = 43;
            this.r_handle = h.x;
            this.r_hv = hv.x;

            [value] Pt z;
            this.r_z = z.x;

            [value] Pt cap = new Pt();
            cap.x = 3;
            var f = () => cap.x;
            cap.x = 5;
            this.r_lam = f();
            this.r_cap = cap.x;

            [value] Pt s2 = this.sub;
            s2.x = 8;

            var m = this.a;
            m.x = 1000;
            this.r_var = this.a.x;

            try {
                Pt n = null;
                [value] Pt bad = n;
                bad.x = 1;
            } catch (const std.exception& e) {
                this.caught_null = 1;
            }
        }
    }
}
