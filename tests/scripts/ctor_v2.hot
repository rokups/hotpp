// Generation 2 of the Squad and Spawner classes: constructor, base call and destructor (S4).
// Squad builds its base with base(label). Spawner builds a Squad with "new" in each Tick.
using "Actor.h";
using <string>;

class Squad : Actor {
    int size = 5;
    int ctor_runs = 0;

    Squad(std.string label, int extra) : base(label) {
        this.size = this.size + extra;
        this.ctor_runs = this.ctor_runs + 1;
        this.Position.x = extra * 10;
    }

    ~Squad() {
        std.printf("[ctor_v2] %s gone\n", this.Name.c_str());
    }
}

class Spawner : Actor {
    int spawned = 0;
    std.string last = "";
    float seen_x = 0.0;
    $Squad kid;

    override void Tick(float dt) {
        $Squad kid = new $Squad(std.string("unit"), 2);
        this.kid = kid;
        this.last = kid.Name;
        this.seen_x = kid.Position.x;
        this.spawned = this.spawned + 1;
    }
}
