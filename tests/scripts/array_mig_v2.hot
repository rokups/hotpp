// Generation 2: the array type stays. The class gets a new field.
using "Actor.h";

class Grid : Actor {
    int[3] a = [1, 2, 3];
    int count = 0;
    int extra = 5;

    override void Tick(float dt) {
        this.a[1] += 100;
        this.count++;
    }
}
