// Generation 2 of iface_v12.hot: Pet lists the interface IVal. The Keeper stores an interface value
// of the Pet at step 1, drops the class handle at step 2 and drops the interface value at step 3.
using "Actor.h";
using "RefPtr.h";

[native, handle("RefPtr<$T>"), weak_handle("WeakRef<$T>")] class RefBase;

interface IVal {
    int Value();
    int R();
}

class Pet : Thing, IVal {
    Pet() : base(9) {
    }

    int Value() { return value + 1; }
    int R() { return Refs(); }
}

class Keeper : Actor {
    $Pet pet = null;
    IVal iv = null;
    [weak]
    Thing seen = null;
    int step = 0;
    int ticks = 0;
    int refs = -1;
    int alive = -1;
    int via = -1;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        if (this.pet == null && this.ticks == 1) {
            this.pet = new $Pet();
            this.seen = this.pet;
        }
        if (this.step == 1) this.iv = this.pet;
        if (this.step == 2) this.pet = null;
        if (this.step == 3) this.iv = null;
        this.refs = this.iv != null ? this.iv.R() : (this.pet?.R() ?? -1);
        this.via = this.iv != null ? this.iv.Value() : -1;
        this.alive = this.seen != null ? this.seen.value : -1;
    }
}
