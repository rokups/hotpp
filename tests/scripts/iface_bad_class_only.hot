// Error: only the class changes. C does not implement the interface signature.
using "Actor.h";
using <string>;

interface IThing {
    int Get(int a);
}

class C : Actor, IThing {
    int Get(int a, int b) { return a + b; }
}

class Holder : Actor {
    $C obj;
    IThing keep;
    int r = 0;
    int is_i = -1;
    int threw = 0;
    std.string why = "";
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        if (this.keep == null) {
            this.obj = new $C();
            this.keep = this.obj;
        }
        this.is_i = 0;
        if (this.obj is IThing) this.is_i = 1;
        this.threw = 0;
        this.r = -5;
        try {
            this.r = this.keep.Get(10);
        } catch (hot.ScriptError ex) {
            this.threw = 1;
            this.why = ex.what();
        }
    }
}
