// Generation 2: the field "held" is weak now. The migration resets it to null (the type changes).
using "Actor.h";

int dead = 0;

class Node {
    Node child = null;
    [weak]
    Node parent = null;
    int hp = 0;

    ~Node() {
        dead = dead + 1;
    }
}

class Keeper : Actor {
    Node kid = null;
    [weak]
    Node held = null;
    int frames = 0;
    int parent_hp = -1;
    int parent_alive = 0;
    int deaths = 0;
    int held_alive = 0;

    override void Tick(float dt) {
        frames = frames + 1;
        if (frames == 1) {
            Node p = new Node();
            p.hp = 9;
            Node c = new Node();
            p.child = c;
            c.parent = p;
            this.kid = c;
            this.held = new Node();
            parent_hp = c.parent.hp;
            parent_alive = c.parent != null ? 1 : 0;
        } else {
            parent_alive = kid.parent != null ? 1 : 0;
        }
        held_alive = held != null ? 1 : 0;
        deaths = dead;
    }
}
