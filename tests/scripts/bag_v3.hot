// Generation 3: Entry gets a field. The vector resets with a warning.
using "Actor.h";
using <vector>;

struct Entry {
    int weight = 0;
    int color = 0;

    Entry(int w) {
        this.weight = w;
    }
}

class Bag : Actor {
    std.vector<Entry> items = std.vector<Entry>();
    int count = 0;

    override void Tick(float dt) {
        this.items.push_back(Entry(9));
        this.count = static_cast<int>(this.items.size());
    }
}
