using "Actor.h";
using <string>;

// A "base(...)" argument binds to a "T&" parameter of a script parent (S23).
class Base : Actor {
    int hp = 0;
    int kind = 0;

    Base(int h, ref int seen) : base(std.string("base")) { this.hp = h; seen = h * 2; this.kind = 1; }
}

class Sink : Actor {
    Sink(ref int made) : base(std.string("sink")) { made = 100; }
}

class Wrap : Sink {
    Wrap(ref int made) : base(made) { }
}

class Mid : Base {
    Mid(int h, ref int seen) : base(h + 1, seen) { }
}

// The chain has two levels. The reference reaches Base from Leaf.
class Leaf : Mid {
    Leaf(int h, ref int seen) : base(h + 1, seen) { }
}

// A constructor with a by-value string parameter (S23).
class Named : Actor {
    std.string label = std.string();

    Named(std.string s) : base(std.string("named")) { this.label = s; }
}

class Spawner : Actor {
    int mid_hp = 0;
    int leaf_hp = 0;
    int seen = 0;
    int leaf_seen = 0;
    int made = 0;
    std.string named = std.string();

    override void Tick(float dt) {
        int s = 0;
        $Mid m = new $Mid(4, s);
        this.mid_hp = m.hp;
        this.seen = s;
        int t = 0;
        $Leaf l = new $Leaf(10, t);
        this.leaf_hp = l.hp;
        this.leaf_seen = t;
        int o = 0;
        $Wrap w = new $Wrap(o);
        this.made = o;
        $Named n = new $Named(std.string("abc"));
        this.named = n.label;
    }
}
