// Tags on properties. A property with a tag has a row in the property table of the layout.
using "Actor.h";

[attribute] class Attribute;

class Holder : Actor {
    int hp = 40;
    [Attribute("Max Health", "AM_DEFAULT")] int Health { get { return hp; } set { hp = value * 2; } }
    [Attribute] float Speed { get; set; } = 1.5f;
    int Plain { get; set; }

    override void Tick(float dt) {
    }
}
