// Generation 3 removes Score(float) and changes the second parameter of Score(int, int) to a string.
using "Actor.h";

class Ov : Actor {
    int total = 0;
    int ticks = 0;
    int kinds = 0;

    int Score(int x) {
        return x * 3;
    }

    int Score(int a, std.string b) {
        return a + static_cast<int>(b.size());
    }

    virtual int Kind(int x) {
        return 1;
    }

    virtual int Kind(std.string s) {
        return 2;
    }

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        float f = 0.5;
        this.total = this.Score(5) + this.Score(1, "abc");
        this.kinds = this.Kind(1) + this.Kind("a");
    }
}

class OvChild : Ov {
    override int Kind(int x) {
        return 10;
    }
}
