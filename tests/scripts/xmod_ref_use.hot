// A "ref" local binds to a "ref" call on an object of an imported class.
using "xmod_ref_lib.hot";

class Reader {
    void Touch() {
        $Shelf shelf = new $Shelf();
        ref s = shelf.At(0);
        s.x = 1;
    }
}
