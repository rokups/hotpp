// Generation 2 of the removed function test. The function rest() is gone.
// Its slot stays defunct. The reload applies live.
using "Actor.h";

class Medic : Actor {
    int hp = 10;

    void heal(int amount) {
        this.hp = this.hp + amount;
    }
}
