// A script class passes a field of a native value type to a native "T*" parameter of a method of
// the native base. The class of the base is in a namespace, so the parameter spelling has no scope.
using "VarHost.h";
using Urho3D;

class Panel : VarHost {
    Variant value;

    void BindPlain() {
        BindDataModelVariant("a", value);
    }

    void BindThis() {
        BindDataModelVariant("b", this.value);
    }

    void SetValue(int n) {
        value = Variant(n);
    }
}
