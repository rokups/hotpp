// Generation 2 of the native pointer field test. The field "target" stays. The script adds "extra".
using "Actor.h";
using "Equip.h";

class Holder : Actor {
    Charm* target = null;
    int ticks = 0;
    int extra = 5;

    override void Tick(float dt) {
        this.ticks = this.ticks + 2;
    }
}
