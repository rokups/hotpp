// Generation 2 of the generation-retention test. The state has no field that holds code. The
// field "keep" goes away, so only the host copy holds generation 1.
using "Actor.h";

class Pt {
    int x = 1;
}

class Holder : Actor {
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
    }
}
