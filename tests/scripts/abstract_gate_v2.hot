// Generation 2 of the Gate class: the class is abstract now. Power has no body. A live object
// traps when it calls Power.
using "Actor.h";

abstract class Gate : Actor {
    int ticks = 0;
    int last = 0;

    Gate() { this.last = 1; }

    abstract int Power();

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        this.last = Power();
    }
}
