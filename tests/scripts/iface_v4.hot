// Reload tests of the interface IThing (design 41b, D10). Generation 1: C lists IThing and the
// Holder keeps one object in a class field and in an interface field.
using "Actor.h";
using <string>;

interface IThing {
    int Get();
}

class C : Actor, IThing {
    int Get() { return 1; }
}

class Holder : Actor {
    $C obj;
    IThing keep;
    int r = 0;
    int is_i = -1;
    int threw = 0;
    std.string why = "";
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        if (this.keep == null) {
            this.obj = new $C();
            this.keep = this.obj;
        }
        this.is_i = 0;
        if (this.obj is IThing) this.is_i = 1;
        this.threw = 0;
        this.r = -5;
        try {
            this.r = this.keep.Get();
        } catch (hot.ScriptError ex) {
            this.threw = 1;
            this.why = ex.what();
        }
    }
}
