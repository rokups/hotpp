using "Actor.h";
using <string>;

// Generation 2 of S27. The new overload Unit(float) has a new key type: the empty tuple.
// Generation 1 has no constructor with that key.
class Unit : Actor {
    int hp = 0;
    int kind = 0;

    Unit(int h) : base(std.string("unit")) { this.hp = h; this.kind = 1; }
    Unit(float f) : base() { this.hp = 40; this.kind = 2; }
}

class Spawner : Actor {
    int hp_int = 0;
    int hp_float = 0;
    int kind_float = 0;

    override void Tick(float dt) {
        $Unit u1 = new $Unit(3);
        $Unit u2 = new $Unit(2.5);
        this.hp_int = u1.hp;
        this.hp_float = u2.hp;
        this.kind_float = u2.kind;
    }
}
