// The importer unit. It uses the base unit: "new" of a class of another unit, a method call and a
// field of that class, a module variable and an overloaded free function.
using "Actor.h";
using "aot_unit_base.hot";

[attribute] class Attribute;

class UnitApp : Actor {
    int hp = 10;
    $UnitBox box;
    int total = 0;
    [Attribute("Total", "AM_DEFAULT")] int Total { get { return total; } set { total = value * 2; } }

    int Score() { return this.hp + 1100; }
    override void Tick(float dt) {
        this.hp = this.hp + 1;
        $UnitBox b = this.box;
        if (b == null) {
            b = new $UnitBox(4);
            this.box = b;
        }
        base_count = base_count + 1;
        this.total = Score();
        this.Position.x = this.total;
        this.Position.y = Scale(5) + Scale(1.5f);
        this.Position.z = b.area() * 100 + b.size * 10 + base_count;
    }
}
