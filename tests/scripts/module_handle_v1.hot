// Generation 1 of a module variable that holds script objects (gap G11).
using "Actor.h";
using <vector>;

class Score {
    int points = 0;
}

std.vector<$Score> scores;
int seen = 0;
int left = 0;

class Hero : Actor {
    override void Tick(float dt) {
        if (scores.size() == 0) { scores.push_back(new $Score()); }
        scores[0].points += 1;
        seen = scores[0].points;
    }
}
