// The reload of attributes_v1.hot: Player drops a tag and Plain gets one. The tag of a field loses its arguments.
using "Actor.h";

[attribute] class Spawnable;
[attribute] class Editor;

[Editor]
class Player : Actor {
    [Editor] int hp = 1;
}

[Spawnable]
class Plain : Actor {
}
