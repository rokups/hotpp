# The package config of the Hot++ SDK. Use: find_package(Hot REQUIRED).
# It makes the targets hot::runtime, hot::aot, hot::hotc and hot::hot_ls. It makes hot::clang_backend
# only when the SDK has the clang files backend. It makes hot::jit_backend only when the SDK has the
# JIT backend. It makes hot::backend when the SDK has at least one of the two. The variables
# HOT_SDK_CLANG_FILES and HOT_SDK_JIT (ON or OFF) tell which backends the SDK has.
# It loads the functions hot_add_host, hot_add_scripts and hot_script_host.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

# The values of the SDK build. The libraries have them built in, so a consumer cannot change them.
set(HOT_SDK_CLANG_FILES @HOT_CLANG_FILES_ENABLED@ CACHE INTERNAL "The Hot++ SDK has the clang files backend")
set(HOT_SDK_JIT @HOT_JIT_ENABLED@ CACHE INTERNAL "The Hot++ SDK has the JIT backend")
set(HOT_PORTABLE @HOT_PORTABLE@ CACHE INTERNAL "The Hot++ SDK is a portable build")
# The format library of the runtime in the SDK: "fmt" or "std". hot_format_library uses it.
set(HOT_SDK_FORMAT_LIB "@HOT_FORMAT_LIB@" CACHE INTERNAL "The format library of the Hot++ SDK")
if(HOT_SDK_FORMAT_LIB STREQUAL "fmt")
    set(HOT_USE_FMT ON CACHE INTERNAL "The Hot++ SDK uses fmt")
else()
    set(HOT_USE_FMT OFF CACHE INTERNAL "The Hot++ SDK uses fmt")
endif()
# The compiler, the target triple and the sysroot of the precompiled script modules
# (hot_add_scripts). They default to the values of the SDK build. A consumer can set them first.
# The compiler has a value only for a cross build of the SDK. Empty means CMAKE_CXX_COMPILER.
# A cross build of the SDK (for example a Windows SDK from Linux) keeps the paths of its build host.
# A path that does not exist on this host is not used.
if(NOT DEFINED HOT_SCRIPT_COMPILER)
    set(_hot_sdk_value "@HOT_SDK_SCRIPT_COMPILER@")
    if(_hot_sdk_value AND NOT EXISTS "${_hot_sdk_value}")
        set(_hot_sdk_value "")
    endif()
    # cl cannot compile a script module: hotc gives it the options of clang++. An MSVC consumer
    # uses clang++ of the Visual Studio component "C++ Clang tools", or a clang++ on PATH.
    # VCINSTALLDIR has a value only in a Developer prompt. A Visual Studio generator gives the
    # installation in CMAKE_GENERATOR_INSTANCE.
    if(NOT _hot_sdk_value AND MSVC)
        set(_hot_sdk_hints "")
        if(DEFINED ENV{VCINSTALLDIR})
            list(APPEND _hot_sdk_hints "$ENV{VCINSTALLDIR}Tools/Llvm/x64/bin")
        endif()
        if(CMAKE_GENERATOR_INSTANCE)
            list(APPEND _hot_sdk_hints "${CMAKE_GENERATOR_INSTANCE}/VC/Tools/Llvm/x64/bin")
        endif()
        find_program(_hot_sdk_clangxx NAMES clang++ HINTS ${_hot_sdk_hints})
        if(_hot_sdk_clangxx)
            set(_hot_sdk_value "${_hot_sdk_clangxx}")
            # The script modules use the headers of the SDK LLVM (lib/clang). An other major
            # version of clang++ can fail on them.
            execute_process(COMMAND "${_hot_sdk_clangxx}" --version OUTPUT_VARIABLE _hot_sdk_out
                            ERROR_QUIET RESULT_VARIABLE _hot_sdk_rc)
            if(_hot_sdk_rc EQUAL 0 AND _hot_sdk_out MATCHES "clang version ([0-9]+)"
               AND NOT "@HOT_LIBCLANG_VERSION_MAJOR@" STREQUAL ""
               AND NOT CMAKE_MATCH_1 STREQUAL "@HOT_LIBCLANG_VERSION_MAJOR@")
                message(WARNING "Hot++: ${_hot_sdk_clangxx} is Clang ${CMAKE_MATCH_1}. The SDK uses "
                        "LLVM @HOT_LIBCLANG_VERSION_MAJOR@. Set HOT_SCRIPT_COMPILER to a clang++ "
                        "@HOT_LIBCLANG_VERSION_MAJOR@, for example of the LLVM release for Windows.")
            endif()
            unset(_hot_sdk_out)
            unset(_hot_sdk_rc)
        endif()
        unset(_hot_sdk_clangxx CACHE)
        unset(_hot_sdk_hints)
    endif()
    set(HOT_SCRIPT_COMPILER "${_hot_sdk_value}" CACHE STRING "The compiler of the script modules")
endif()
if(NOT DEFINED HOT_HOTC_TARGET)
    set(HOT_HOTC_TARGET "@HOT_HOTC_TARGET@" CACHE STRING "The target triple of the script modules (--target)")
endif()
if(NOT DEFINED HOT_SCRIPT_SYSROOT)
    set(_hot_sdk_value "@HOT_SCRIPT_SYSROOT@")
    if(_hot_sdk_value AND NOT IS_DIRECTORY "${_hot_sdk_value}")
        # A native MinGW (for example MSYS2 MINGW64): the sysroot is the parent folder of the folder
        # of g++, when it has the C++ headers (include/c++). Else no sysroot.
        set(_hot_sdk_value "")
        get_filename_component(_hot_cxx_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
        get_filename_component(_hot_cxx_root "${_hot_cxx_dir}/.." ABSOLUTE)
        if(CMAKE_CXX_COMPILER AND IS_DIRECTORY "${_hot_cxx_root}/include/c++")
            set(_hot_sdk_value "${_hot_cxx_root}")
        endif()
    endif()
    set(HOT_SCRIPT_SYSROOT "${_hot_sdk_value}" CACHE PATH "The sysroot of the script modules (--sysroot)")
endif()
# The compiler headers of the libclang in the SDK (a Windows SDK has libclang.dll and
# lib/clang/<major>/include). hotc parses with them. A value of the consumer wins.
if(NOT DEFINED CLANG_RESOURCE_DIR)
    file(GLOB _hot_sdk_res LIST_DIRECTORIES true "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/clang/[0-9]*")
    list(LENGTH _hot_sdk_res _hot_sdk_res_count)
    if(_hot_sdk_res_count EQUAL 1)
        set(CLANG_RESOURCE_DIR "${_hot_sdk_res}")
    endif()
endif()
# The default C++ standard of the host, when the consumer sets none (hot_effective_cxx_standard).
set_property(GLOBAL PROPERTY HOT_DEFAULT_CXX_STANDARD @HOT_SDK_CXX_STANDARD@)

# The Clang package of the SDK build. Its folder is a hint, so the package of the same version wins.
set(_hot_clang_hints "")
if(NOT "@HOT_CLANG_CMAKE_DIR@" STREQUAL "")
    set(_hot_clang_hints HINTS "@HOT_CLANG_CMAKE_DIR@")
endif()

if(HOT_SDK_JIT)
    # LLVMConfig.cmake probes C headers, so the C language must be on.
    get_property(_hot_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
    if(NOT "C" IN_LIST _hot_languages)
        enable_language(C)
    endif()
    find_dependency(LLVM CONFIG)
    find_dependency(Clang CONFIG ${_hot_clang_hints})
endif()

# HotScripts.cmake keeps this value (it sets the variable only when it is not defined).
set(HOT_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@" CACHE INTERNAL "The include dir of Hot++")

include("${CMAKE_CURRENT_LIST_DIR}/HotTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/HotFormat.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/HotScripts.cmake")

# libclang. The export holds no path of it. Find it here. Only hot::hotc_lib and the targets that
# link it (hot::clang_backend, hot::backend, hot::jit_backend) need it. A program in AOT mode does
# not. First choice: the target libclang of the Clang CMake package, if its major version is the
# version of the SDK build. A cache value of the user in HOT_CLANG_C_LIBRARY wins. Fallback:
# find_library (the folder of the SDK build, then the standard places).
if(NOT TARGET libclang AND NOT HOT_CLANG_C_LIBRARY)
    if(NOT HOT_SDK_JIT)
        # LLVMConfig.cmake probes C headers, so the C language must be on.
        get_property(_hot_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
        if(NOT "C" IN_LIST _hot_languages)
            enable_language(C)
        endif()
    endif()
    find_package(Clang CONFIG QUIET ${_hot_clang_hints})
endif()
# The package must have the major version of the SDK build. Else use the fallback.
set(_hot_use_package OFF)
if(TARGET libclang AND NOT HOT_CLANG_C_LIBRARY)
    set(_hot_use_package ON)
    if(NOT "@HOT_LIBCLANG_VERSION_MAJOR@" STREQUAL "" AND Clang_VERSION)
        string(REGEX MATCH "^[0-9]+" _hot_pkg_major "${Clang_VERSION}")
        if(NOT _hot_pkg_major STREQUAL "@HOT_LIBCLANG_VERSION_MAJOR@")
            set(_hot_use_package OFF)
        endif()
    endif()
endif()
if(_hot_use_package)
    set_property(TARGET hot::hotc_lib APPEND PROPERTY INTERFACE_LINK_LIBRARIES libclang)
else()
    find_library(HOT_CLANG_C_LIBRARY NAMES clang libclang
                 HINTS "@HOT_CLANG_C_LIBRARY_DIR@" DOC "The libclang library for Hot++")
    if(HOT_CLANG_C_LIBRARY)
        set_property(TARGET hot::hotc_lib APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${HOT_CLANG_C_LIBRARY}")
    else()
        message(WARNING "Hot++: libclang is not found. The SDK was built with @HOT_CLANG_C_LIBRARY@. "
            "Install libclang or set HOT_CLANG_C_LIBRARY to the file. Without it the targets "
            "hot::hotc_lib, hot::clang_backend and hot::backend cannot link.")
        set_property(TARGET hot::hotc_lib APPEND PROPERTY INTERFACE_LINK_LIBRARIES HOT_CLANG_C_LIBRARY-NOTFOUND)
    endif()
endif()

# The tools of the SDK, as file paths.
get_target_property(HOT_HOTC_EXECUTABLE hot::hotc LOCATION)
get_target_property(HOT_LS_EXECUTABLE hot::hot_ls LOCATION)

check_required_components(Hot)
