// Generation 3 of the signature change (design 5.3, S17).
// The signature of generation 2 stays. Only the body changes, so the thunk of generation 2 keeps working.
using "Actor.h";

class Medic : Actor {
    int hp = 10;

    void heal(int amount, int bonus) {
        this.hp = this.hp + amount + bonus * 2;
    }
}
