// Generation 2: the field label is now title, and the field note is new.
// The std.string and the std.vector move to the new block.
using <vector>;
using "<algorithm>";
using <string>;
using "Actor.h";
using "Math.h";
using "Util.h";

class Tracker : Actor {
    [alias("label")] std.string title = "new title";
    std.vector<int> history = std.vector<int>();
    float dist = 0.0;
    float lowest = 0.0;
    float sum = 0.0;
    std.string described = "";
    std.string note = "note from generation 2";

    override void Tick(float dt)  {
        var v = std.vector<float>();
        v.push_back(9.0);
        v.push_back(8.0);
        v.push_back(7.0);
        std.sort(v.begin(), v.end(), std.greater<float>());
        this.lowest = Math.Min(v[0], v[2]);
        this.dist = Distance(this.Position, Vec3(1, 1, 1));
        this.sum = Util.Sum(this.Position) * 2.0;
        this.described = Util.Describe(*this);
        this.Name = FormatVec(this.Position);
        this.history.push_back(static_cast<int>(this.history.size()) * 10);
    }
}
