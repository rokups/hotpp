// Generation 1 of the Beeper class (experiments R3 and R6).
// The method arm stores an arrow lambda in a World timer.
import "Actor.h";

class Beeper : Actor {
    ticks: int = 0;
    fired: int = 0;

    override Tick(dt: float) {
        this.ticks = this.ticks + 1;
    }

    fn arm(w: World&, delay: float) {
        w.AddTimer(delay, () => {
            this.fired = this.fired + 1;
            std::printf("[timer v1] %s: fired=%d\n", this.Name.c_str(), this.fired);
        });
    }
}
