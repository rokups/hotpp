// Generation 1 of the kinds of script classes (S5, design 7.10.1).
// Stats is a [value] class. It lives inline in the state block and a copy is a real copy.
// Counter has no base class. It is a handle: "new Counter(...)" gives a std::shared_ptr.
// Hero has a native base. It uses the handle of that base.
using "Actor.h";
using <string>;

[value] class Stats {
    float hp = 100.0;
    float armor = 2.0;

    Stats(float hp_start, float armor_start) {
        this.hp = hp_start;
        this.armor = armor_start;
    }

    float Effective() { return this.hp * this.armor; }

    void Hurt(float damage) { this.hp = this.hp - damage; }
}

class Counter {
    int count = 0;

    Counter(int start) {
        this.count = start;
        std.printf("[kinds_v1] counter %d made\n", start);
    }

    ~Counter() {
        std.printf("[kinds_v1] counter %d gone\n", this.count);
    }
}

class Hero : Actor {
    Stats stats = Stats(50.0, 2.0);
    Stats saved;
    Counter counter;
    float effective = 0.0;
    int ticks = 0;

    override void Tick(float dt) {
        this.ticks = this.ticks + 1;
        if (this.counter == null) {
            this.counter = new Counter(10);
        }
        this.saved = this.stats;
        this.stats.Hurt(10.0);
        this.effective = this.stats.Effective();
    }
}
