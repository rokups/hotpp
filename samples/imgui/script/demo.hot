// A user interface script. The host draws it with Dear ImGui.
// The script calls the ImGui API directly. A pointer parameter takes the address of a field.
using "UiApp.h";
using "imgui.h";

class Demo : UiApp {
    int clicks = 0;
    float speed = 1.0;
    bool on = false;

    override void Frame() {
        if (ImGui.Begin("Demo")) {
            ImGui.Text("Hello from a script");
            ImGui.Text("Clicks: %d", clicks);
            if (ImGui.Button("Click me")) {
                clicks = clicks + 1;
            }
            ImGui.Checkbox("Enabled", on);
            ImGui.SliderFloat("Speed", speed, 0.0f, 10.0f);
        }
        ImGui.End();
    }
}
