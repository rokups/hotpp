// The run-time override of the unit wolf. The program compiles this file while it runs. Wolf
// has one more field, howls. The fields bites and the base state stay.
using "Creature.h";
using <string>;

class Wolf : Creature {
    int bites = 0;
    int howls = 0;

    Wolf() : base(std.string("wolf")) {
    }

    override void Tick(float dt) {
        this.bites = this.bites + 1;
        this.howls = this.howls + 1;
        this.Hp = this.Hp - 1;
        std.printf("[override] %s: bites=%d hp=%d howls=%d\n", this.Name.c_str(), this.bites, this.Hp, this.howls);
    }
}
