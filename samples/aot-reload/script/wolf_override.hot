// The run-time override of the unit wolf. The program compiles this file while it runs. Wolf
// has one more field, howls. The fields bites and the base state stay.
using "Creature.h";
using <string>;

class Wolf : Creature {
    int bites = 0;
    int howls = 0;

    Wolf() : base(std.string("wolf")) {
    }

    override void Tick(float dt) {
        bites = bites + 1;
        howls = howls + 1;
        Hp = Hp - 1;
        std.printf("[override] %s: bites=%d hp=%d howls=%d\n", Name.c_str(), bites, Hp, howls);
    }
}
