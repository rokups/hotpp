// The script of the sample. Wolf derives from the host class Creature and overrides Tick.
using "Creature.h";
using <string>;

class Wolf : Creature {
    int bites = 0;

    Wolf() : base(std.string("wolf")) {
    }

    override void Tick(float dt) {
        bites = bites + 1;
        Hp = Hp - 1;
        std.printf("[wolf] %s: bites=%d hp=%d\n", Name.c_str(), bites, Hp);
    }
}
