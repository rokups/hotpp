{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hot++",
  "scopeName": "source.hot",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attribute" },
    { "include": "#inline-attribute" },
    { "include": "#using" },
    { "include": "#declaration" },
    { "include": "#expression" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.hot", "match": "//.*$" },
        {
          "name": "comment.block.hot",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attribute": {
      "name": "meta.attribute.hot",
      "begin": "^\\s*(\\[)(?=\\s*[A-Za-z_]\\w*\\s*[,\\](])",
      "beginCaptures": { "1": { "name": "punctuation.definition.attribute.begin.hot" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.attribute.end.hot" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#number" },
        { "name": "entity.other.attribute-name.hot", "match": "\\b[A-Za-z_]\\w*\\b(?=\\s*[,\\](])" },
        { "name": "constant.language.hot", "match": "\\b(?:true|false|null)\\b" },
        { "name": "punctuation.separator.comma.hot", "match": "," },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#string" },
            { "include": "#number" },
            { "name": "constant.language.hot", "match": "\\b(?:true|false|null)\\b" },
            { "name": "variable.parameter.hot", "match": "\\b[A-Za-z_]\\w*\\b" },
            { "name": "punctuation.separator.comma.hot", "match": "," }
          ]
        }
      ]
    },
    "inline-attribute": {
      "match": "(\\[)\\s*(weak|byval)\\s*(\\])(?=\\s*[A-Za-z_])",
      "captures": {
        "0": { "name": "meta.attribute.hot" },
        "1": { "name": "punctuation.definition.attribute.begin.hot" },
        "2": { "name": "entity.other.attribute-name.hot" },
        "3": { "name": "punctuation.definition.attribute.end.hot" }
      }
    },
    "using": {
      "match": "\\b(using)\\b\\s*(?:(<[^>\\n]*>)|(\"[^\"\\n]*\"))?",
      "captures": {
        "1": { "name": "keyword.control.import.hot" },
        "2": { "name": "string.quoted.other.lt-gt.include.hot" },
        "3": { "name": "string.quoted.double.include.hot" }
      }
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(class|struct|enum|interface)\\b(?:\\s+([A-Za-z_]\\w*))?(?:\\s*(:)\\s*([^{;]+?)(?=\\s*[{;]))?",
          "captures": {
            "1": { "name": "storage.type.class.hot" },
            "2": { "name": "entity.name.type.class.hot" },
            "3": { "name": "punctuation.separator.inheritance.hot" },
            "4": { "name": "entity.other.inherited-class.hot" }
          }
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        { "include": "#inline-attribute" },
        { "include": "#collection-literal" },
        { "include": "#structured-binding" },
        { "include": "#type-test" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#builtin-function" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "name": "punctuation.terminator.statement.hot", "match": ";" },
        { "name": "punctuation.separator.comma.hot", "match": "," }
      ]
    },
    "collection-literal": {
      "name": "meta.collection-literal.hot",
      "begin": "(?<![\\w)\\]])(\\[)",
      "beginCaptures": { "1": { "name": "punctuation.definition.collection.begin.hot" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.collection.end.hot" } },
      "patterns": [ { "include": "#expression" } ]
    },
    "structured-binding": {
      "match": "\\b(var|ref)\\b\\s*(\\()([^()\\n]*)(\\))(?=\\s*(?:=(?!=)|\\bin\\b))",
      "captures": {
        "1": { "name": "storage.type.hot" },
        "2": { "name": "punctuation.definition.binding.begin.hot" },
        "3": {
          "patterns": [
            { "name": "variable.other.local.hot", "match": "\\b[A-Za-z_]\\w*\\b" },
            { "name": "punctuation.separator.comma.hot", "match": "," }
          ]
        },
        "4": { "name": "punctuation.definition.binding.end.hot" }
      }
    },
    "type-test": {
      "patterns": [
        {
          "match": "\\b(is)\\s+(?!(?:null|true|false)\\b)([A-Za-z_][\\w.]*(?:<[^<>\\n]*>)?[*]?)(?:\\s+(?!(?:is|as|in)\\b)([A-Za-z_]\\w*)\\b(?!\\s*\\())?",
          "captures": {
            "1": { "name": "keyword.operator.word.hot" },
            "2": { "name": "entity.name.type.hot" },
            "3": { "name": "variable.other.local.hot" }
          }
        },
        {
          "match": "\\b(as)\\s+([A-Za-z_][\\w.]*(?:<[^<>\\n]*>)?[*]?)",
          "captures": {
            "1": { "name": "keyword.operator.word.hot" },
            "2": { "name": "entity.name.type.hot" }
          }
        }
      ]
    },
    "builtin-function": {
      "match": "(?<![.\\w])(enumerate|range)\\b(?=\\s*\\()",
      "captures": { "1": { "name": "support.function.builtin.hot" } }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.hot",
          "match": "\\b(?:if|else|while|do|for|foreach|in|return|break|continue|switch|case|default|await|static_assert)\\b"
        },
        {
          "name": "keyword.control.exception.hot",
          "match": "\\b(?:try|catch|finally|throw)\\b"
        },
        {
          "name": "storage.modifier.hot",
          "match": "\\b(?:public|private|protected|override|virtual|abstract|async|const|get|set|ref|out)\\b"
        },
        {
          "name": "storage.type.hot",
          "match": "\\b(?:var|void)\\b"
        },
        {
          "name": "keyword.operator.new.hot",
          "match": "\\b(?:new|delete)\\b"
        },
        {
          "name": "keyword.operator.word.hot",
          "match": "\\b(?:is|as)\\b"
        },
        {
          "name": "variable.language.hot",
          "match": "\\b(?:this|base)\\b"
        },
        {
          "name": "constant.language.hot",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.builtin.hot",
      "match": "\\b(?:bool|sbyte|int8|byte|uint8|short|int16|ushort|uint16|int|int32|uint|uint32|long|int64|ulong|uint64|nint|intptr|nuint|uintptr|float|double|char|wchar|char16)\\b"
    },
    "function-call": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.hot" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.hot", "match": "->" },
        { "name": "storage.type.function.arrow.hot", "match": "=>" },
        { "name": "punctuation.accessor.safe.hot", "match": "\\?\\." },
        { "name": "keyword.operator.comparison.hot", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.hot", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.hot", "match": "(?:<<|>>|[-+*/%&|^])?=" },
        { "name": "keyword.operator.arithmetic.hot", "match": "\\+\\+|--|[-+*/%&|^~]|<<|>>" },
        { "name": "keyword.operator.coalesce.hot", "match": "\\?\\?" },
        { "name": "keyword.operator.ternary.hot", "match": "\\?|:" },
        { "name": "punctuation.accessor.hot", "match": "\\." }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.hot",
          "match": "\\b0[xX][0-9a-fA-F]+(?:[uU]?[lL]{0,2})\\b"
        },
        {
          "name": "constant.numeric.float.hot",
          "match": "(?:\\b\\d+\\.\\d*|\\B\\.\\d+|\\b\\d+(?=[eE]))(?:[eE][+-]?\\d+)?[fF]?\\b|\\b\\d+[fF]\\b"
        },
        {
          "name": "constant.numeric.integer.hot",
          "match": "\\b\\d+(?:[uU]?[lL]{0,2})\\b"
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.hot",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        { "name": "constant.character.escape.hot", "match": "\\\\." }
      ]
    },
    "string": {
      "name": "string.quoted.double.hot",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.hot", "match": "\\\\." },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.hot",
      "begin": "\\$\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.hot" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.hot" } },
      "contentName": "meta.embedded.expression.hot",
      "patterns": [
        {
          "name": "constant.other.format-spec.hot",
          "match": ":(?!\\s)[^\\s:?{}\"]*(?=\\})"
        },
        { "include": "#interpolation-braces" },
        { "include": "#expression-in-string" }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#interpolation-braces" },
        { "include": "#expression-in-string" }
      ]
    },
    "expression-in-string": {
      "patterns": [
        { "include": "#number" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "name": "punctuation.separator.comma.hot", "match": "," }
      ]
    }
  }
}
