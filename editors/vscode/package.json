{
  "name": "spp",
  "displayName": "S++",
  "description": "Syntax highlighting and language server client for S++ scripts (.hot). Shows the hotc errors of .cpp scripts.",
  "version": "0.1.0",
  "publisher": "spp",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "main": "./src/extension.js",
  "activationEvents": ["onLanguage:hot", "onLanguage:cpp", "onCommand:spp.showScriptPosition", "onCommand:spp.restartServer"],
  "contributes": {
    "commands": [
      {
        "command": "spp.showScriptPosition",
        "title": "S++: Show Script Position"
      },
      {
        "command": "spp.restartServer",
        "title": "S++: Restart Language Server"
      }
    ],
    "languages": [
      {
        "id": "hot",
        "aliases": ["S++", "hot"],
        "extensions": [".hot"],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      { "language": "hot" }
    ],
    "grammars": [
      {
        "language": "hot",
        "scopeName": "source.hot",
        "path": "./syntaxes/spp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "S++",
      "properties": {
        "spp.server.path": {
          "type": "string",
          "default": "hot-ls",
          "description": "Path of the S++ language server binary. The default finds hot-ls in PATH. ${workspaceFolder} is expanded."
        },
        "spp.server.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["--stdio"],
          "description": "Arguments for the language server. ${workspaceFolder} is expanded."
        },
        "spp.server.enable": {
          "type": "boolean",
          "default": true,
          "description": "Start the language server. Highlighting works when this is off."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "scripts": {
    "test": "node test/grammar.test.js && node test/expand.test.js && node test/only_spp.test.js"
  }
}
