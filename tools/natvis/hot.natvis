<?xml version="1.0" encoding="utf-8"?>
<!-- Hot++ natvis for Visual Studio (design 4.12). Visual Studio never loaded it (no Windows here).
     tests/unit/python/test_natvis.py checks the XML and the type names.
     A state block "hot_state_X" (generated) or "XState_gN" (hand-written) and a shell "X_Shell"
     show as the script class X.
     The generated names follow the translator: see tools/lldb/hot_formatters.py. -->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <!-- A generated state block. Visual Studio shows the fields with their names. -->
  <Type Name="hot_state_*">
    <DisplayString>script state block</DisplayString>
    <Expand>
      <ExpandedItem>this,nd</ExpandedItem>
    </Expand>
  </Type>
  <!-- A state block of a hand-written module with a generation in the name. -->
  <Type Name="*State_g*">
    <DisplayString>script state block</DisplayString>
    <Expand>
      <ExpandedItem>this,nd</ExpandedItem>
    </Expand>
  </Type>
  <!-- A shell object. It shows the record of the shell core. The state and the live list are in hot::ShellBase. -->
  <Type Name="*_Shell">
    <DisplayString>script object</DisplayString>
    <Expand>
      <ExpandedItem>(hot::ShellCore*)this,nd</ExpandedItem>
    </Expand>
  </Type>
  <!-- A handle to a shell. -->
  <Type Name="std::shared_ptr&lt;*_Shell&gt;">
    <DisplayString Condition="_Ptr == nullptr">null handle</DisplayString>
    <DisplayString>script handle (use_count={_Rep-&gt;_Uses})</DisplayString>
    <Expand>
      <ExpandedItem Condition="_Ptr != nullptr">*_Ptr</ExpandedItem>
    </Expand>
  </Type>
</AutoVisualizer>
