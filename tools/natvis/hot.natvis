<?xml version="1.0" encoding="utf-8"?>
<!-- Hot++ natvis for Visual Studio (design 4.12). It was NOT tested: the session had no Windows.
     A state block "XState_gN" and a shell "X_Shell" show as the script class X.
     The generated names follow the translator: see tools/lldb/hot_formatters.py. -->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <!-- Any state block of any generation. Visual Studio shows the fields with their names. -->
  <Type Name="*State_g*">
    <DisplayString>script state block</DisplayString>
    <Expand>
      <ExpandedItem>this,nd</ExpandedItem>
    </Expand>
  </Type>
  <!-- A shell object. It shows the members of the shell base. -->
  <Type Name="*_Shell">
    <DisplayString>script object</DisplayString>
    <Expand>
      <ExpandedItem>(hot::ShellBase*)this,nd</ExpandedItem>
    </Expand>
  </Type>
  <!-- A handle to a shell. -->
  <Type Name="std::shared_ptr&lt;*_Shell&gt;">
    <DisplayString Condition="_Ptr == nullptr">null handle</DisplayString>
    <DisplayString>script handle (use_count={_Rep-&gt;_Uses})</DisplayString>
    <Expand>
      <ExpandedItem Condition="_Ptr != nullptr">*_Ptr</ExpandedItem>
    </Expand>
  </Type>
</AutoVisualizer>
