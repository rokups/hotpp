// Case: field read and write of another script object through a handle (the state indirection).
using "BenchEngine.h";

class BenchCell {
    int x = 0;
    int y = 1;
}

class BenchStateField : BenchBase {
    $BenchCell c = null;

    override long Run(int n) {
        if (c == null) c = new $BenchCell();
        $BenchCell cell = c;
        if (cell == null) return 0;
        long s = 0;
        for (int i = 0; i < n; i++) {
            cell.x = (cell.x + i) & 65535;
            cell.y = cell.y ^ cell.x;
            s += cell.y;
        }
        return s;
    }
}
