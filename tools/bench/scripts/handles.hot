// Case: handle dereference and null check along a chain of four objects.
using "BenchEngine.h";

class BenchNode {
    int v = 0;
    $BenchNode next = null;
}

class BenchHandles : BenchBase {
    $BenchNode head = null;

    override long Run(int n) {
        if (head == null) {
            $BenchNode first = new $BenchNode();
            first.v = 1;
            head = first;
            $BenchNode cur = first;
            for (int j = 1; j < 4; j++) {
                if (cur == null) break;
                $BenchNode node = new $BenchNode();
                node.v = j + 1;
                cur.next = node;
                cur = node;
            }
        }
        long s = 0;
        $BenchNode start = head;
        if (start == null) return 0;
        $BenchNode p = start;
        for (int i = 0; i < n; i++) {
            if (p == null) p = start;
            s += p.v;
            p = p.next;
        }
        return s;
    }
}
