// Case: a virtual call from script to script through the base class (slot dispatch).
using "BenchEngine.h";

class BenchShape {
    int w = 2;

    virtual int Area(int x) {
        return x;
    }
}

class BenchSquare : BenchShape {
    override int Area(int x) {
        return x * w + 1;
    }
}

class BenchSlotScript : BenchBase {
    $BenchShape s = null;

    override long Run(int n) {
        if (s == null) s = new $BenchSquare();
        $BenchShape shape = s;
        if (shape == null) return 0;
        long t = 0;
        for (int i = 0; i < n; i++) {
            t += shape.Area(i & 255);
        }
        return t;
    }
}
