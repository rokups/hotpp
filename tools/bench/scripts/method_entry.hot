// Case: a call of a small script method on this object (the live check at the method entry).
using "BenchEngine.h";

class BenchEntry : BenchBase {
    int k = 1;

    int Add(int x) {
        return x + k;
    }

    override long Run(int n) {
        long s = 0;
        for (int i = 0; i < n; i++) {
            s += Add(i ^ (int)(s & 7));
        }
        return s;
    }
}
