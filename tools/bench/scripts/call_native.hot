// Case: script to native call. Run calls the native method NativeAdd in a loop.
using "BenchEngine.h";

class BenchCallNative : BenchBase {
    override long Run(int n) {
        long s = 0;
        for (int i = 0; i < n; i++) s += NativeAdd(i, 1);
        return s;
    }
}
