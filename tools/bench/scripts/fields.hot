// Case: field read and write loop.
using "BenchEngine.h";

class BenchFields : BenchBase {
    int a = 1;
    int b = 2;
    float f = 0.5;

    override long Run(int n) {
        for (int i = 0; i < n; i++) {
            a = (a + i) & 65535;
            b = b ^ a;
            f = f + 0.25;
        }
        return a + b + static_cast<long>(f);
    }
}
