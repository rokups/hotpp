// Case: a loop with a method call that changes fields in each iteration.
using "BenchEngine.h";

class BenchMethodLoop : BenchBase {
    int a = 0;
    int b = 0;

    void Step(int d) {
        a = (a + d) & 65535;
        b = b + a;
        if (b > 1000000) b = b - 1000000;
    }

    override long Run(int n) {
        for (int i = 0; i < n; i++) Step(i);
        return a + b;
    }
}
